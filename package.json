{
  "name": "the-bench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An interactive course for the Sri Lankan G.C.E. A/L ICT unit on IoT, embedded systems and Arduino.",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build && node scripts/postbuild.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b --noEmit",
    "test": "node scripts/run-tests.mjs && node scripts/test-contrast.mjs",
    "test:contrast": "node scripts/test-contrast.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
